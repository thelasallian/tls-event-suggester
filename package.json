    "react-oidc-context": "^3.1.0",
    "oidc-client-ts": "^3.0.0"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "wrangler": "^3.80.0",
    "drizzle-kit": "^0.30.0",
    "@cloudflare/workers-types": "^4.20240801.0",
    "typescript": "^5.6.0"
